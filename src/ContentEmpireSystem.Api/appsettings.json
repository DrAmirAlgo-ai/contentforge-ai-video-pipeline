{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite",
    "BackgroundBootstrap": true,
    "BootstrapTimeoutSeconds": 120
  },
  "ConnectionStrings": {
    "Sqlite": "Data Source=contentempire.db;Cache=Shared;Mode=ReadWriteCreate",
    "SqlServer": "Server=(localdb)\\mssqllocaldb;Database=ContentEmpireSystem;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true;Connect Timeout=15"
  },
  "Workload": {
    "MaxConcurrentFfmpeg": 1,
    "MaxConcurrentAiGeneration": 1,
    "MaxConcurrentProduction": 1,
    "ProductionQueueCapacity": 32,
    "ProjectLockWaitSeconds": 30,
    "QueueWaitSeconds": 90
  },
  "Auth": {
    "AllowPublicRegistration": false,
    "Jwt": {
      "Key": "",
      "Issuer": "ContentForge",
      "Audience": "ContentForge",
      "ExpireMinutes": 480
    },
    "BootstrapAdmin": {
      "Enabled": true,
      "Email": "admin@contentforge.local",
      "Password": "",
      "DisplayName": "Admin"
    }
  }
}

